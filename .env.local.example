# Optional. Without a key the app still works: the internship builder and match
# summaries fall back to a rule-based drafter, and the UI says so.
ANTHROPIC_API_KEY=

# Used to sign certificates. Change it before any real use.
PRAMANA_SECRET=dev-only-secret-change-before-real-use

# Optional. Set if you deploy, so certificate QR codes point at the public URL.
# PRAMANA_PUBLIC_URL=https://your-domain.example
